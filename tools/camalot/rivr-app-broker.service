[Unit]
Description=Validate and execute one batch of Rivr builder app lifecycle requests
After=docker.service local-fs.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/rivr-app-broker.py
# The broker itself is a thin orchestrator; builds run inside the capped
# BuildKit container and app workloads inside their own capped containers,
# so the broker process needs only modest resources.
Nice=10
CPUQuota=50%
MemoryMax=256M
TasksMax=64
TimeoutStartSec=1800
PrivateTmp=no
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
