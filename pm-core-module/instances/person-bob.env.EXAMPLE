# =============================================================================
# SANITIZED TEMPLATE — person-bob instance of the rivr-person pm-core module.
#
# This is an EXAMPLE. Every credential/secret VALUE below has been replaced with
# a __PLACEHOLDER_*__ token. NON-secret parity config (DOMAIN, DATABASE_NAME,
# INSTANCE_ID, *_URL, Stripe price IDs, agent UUIDs) is kept verbatim as a
# reference for how a real instance is shaped.
#
# The REAL per-instance env (with live values) is git-ignored and lives ONLY on
# the deploy host at:
#     /opt/docker-lab/modules/rivr-person/instances/person-bob.env
# File-based docker secrets (rivr_db_password, rivr_auth_secret, minio_*,
# matrix_admin_token*, synapse_*_registration_shared_secret, ...) live at:
#     /opt/docker-lab/secrets/            (see ../secrets-required.txt)
#
# To provision a new instance: copy this file to instances/<slug>.env and fill
# each __PLACEHOLDER_*__ from the host secret store / your Stripe + federation
# configuration.
# =============================================================================

MODULE_SLUG=person-bob
DOMAIN=bob.rivr.social
MATRIX_TOKEN_SRC=matrix_admin_token_person_bob
SYNAPSE_REG_SRC=synapse_person_bob_registration_shared_secret
PERSON_CLAUDE_HOST_DIR=/opt/rivr-secrets/person-bob-claude
ASSET_PUBLIC_BASE_URL=https://s3.rivr.social
AUTH_TRUST_HOST=true
BASE_URL=https://bob.rivr.social
DATABASE_HOST=postgres
DATABASE_NAME=rivr_person_bob
DATABASE_PORT=5432
DATABASE_USER=rivr
FEDERATION_DELIVER_CRON_SECRET=__PLACEHOLDER_federation_deliver_cron_secret__
FEDERATION_PEER_SECRET_GLOBAL=__PLACEHOLDER_federation_peer_secret_global__
FEDERATION_SYNC_CRON_SECRET=__PLACEHOLDER_federation_sync_cron_secret__
GLOBAL_IDENTITY_AUTHORITY_URL=https://app.rivr.social
HOSTNAME=0.0.0.0
INSTANCE_ID=33333333-3333-3333-3333-333333333333
INSTANCE_SLUG=bob
INSTANCE_TYPE=person
MATRIX_DELEGATED_SERVER=matrix.person-bob.rivr.social:443
MATRIX_HOMESERVER_URL=http://synapse-person_bob:8008
MATRIX_SERVER_NAME=person-bob.rivr.social
MINIO_AVATAR_BUCKET=rivr-avatars
MINIO_BUCKET=rivr-uploads
MINIO_BUCKET_PREFIX=instances/bob/
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
NEXTAUTH_URL=https://bob.rivr.social
NEXT_PUBLIC_APP_URL=https://bob.rivr.social
NEXT_PUBLIC_BASE_URL=https://bob.rivr.social
NEXT_PUBLIC_DOMAIN=rivr.social
NEXT_PUBLIC_GLOBAL_IDENTITY_AUTHORITY_URL=https://app.rivr.social
NEXT_PUBLIC_MATRIX_HOMESERVER_URL=https://matrix.person-bob.rivr.social
NEXT_PUBLIC_MINIO_URL=https://s3.rivr.social
NEXT_PUBLIC_REGISTRY_URL=https://app.rivr.social/api/federation/registry
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=__PLACEHOLDER_next_public_stripe_publishable_key__
NEXT_TELEMETRY_DISABLED=1
NODE_DISPLAY_NAME=Bob Smith
NODE_ENV=production
NODE_SLUG=bob
PORT=3000
PRIMARY_AGENT_ID=b3a639d1-8b8e-4578-abb1-30721e00a3c7
REGISTRY_URL=https://app.rivr.social/api/federation/registry
SMTP_FROM=admin@rivr.social
SMTP_HOST=smtp.gmail.com
SMTP_PASS_FILE=/run/secrets/rivr_google_smtp_password
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=admin@rivr.social
STRIPE_PUBLISHABLE_KEY=__PLACEHOLDER_stripe_publishable_key__
STRIPE_SECRET_KEY=__PLACEHOLDER_stripe_secret_key__
