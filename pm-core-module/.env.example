# RIVR Person module — per-INSTANCE environment. Copy to .env on the target host.
# ONE module, many instances: everything that differs lives HERE.
DOMAIN=bob.rivr.social
INSTANCE_SLUG=person-bob
INSTANCE_TYPE=person
RIVR_DB_NAME=rivr_person_bob
NEXTAUTH_URL=https://bob.rivr.social
# RIVR_IMAGE is loaded from image.lock by the deploy script (single-sourced digest).
